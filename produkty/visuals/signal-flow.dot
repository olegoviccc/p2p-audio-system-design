digraph Signal {
  graph [rankdir=LR,bgcolor="#ffffff",pad=.28,nodesep=.32,ranksep=.54,splines=polyline,labelloc=t,labeljust=l,fontname="DejaVu Sans Bold",fontsize=24,label="ПРОДУКТЫ  /  Первичная схема подключения\n26.11.2026 · Пунктиром показаны управление и резерв"];
  node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=11,color="#9cacb6",fillcolor="#f5f8fa",margin=".17,.12"];
  edge [fontname="DejaVu Sans",fontsize=9,color="#36546b",fontcolor="#253444",arrowsize=.65];
  ipad [label="iPad у стойки\nаудиоадаптер + зарядка"]; dj [label="DJ-контроллер\nрезервный стереовход"];
  mixer [label="CM82 · шкаф\nC: iPad → A+B\nD: DJ → A\nоба RCA-входа суммируют L/R",fillcolor="#e9f2fa"];
  wall [label="Ручка «Зал»\nCRC-VEU · у стойки"];
  dsp [label="DCX2496LE\nInput A → Out 1–5\nфильтры / лимитеры",fillcolor="#e9f2fa"];
  pa [label="Volta LIVE 4.400\nXLR IN 1–4 → OUT 1–4"];
  hall [label="4 × KEF Q350 · зал\nЗ1 · касса / гостевая сторона\nЗ2 · гардероб / диагональная стойка\nЗ3 · окна со стороны входа\nЗ4 · окна со стороны санузла",fillcolor="#e9f2fa"];
  sub [label="KEF Kube 8 MIE · активный саб\nRCA/LFE и розетка 230 В\nместо уточняется"];
  match [label="Согласование уровня\nбалансный моно → RCA"];
  tr [label="TR-40LS · шкаф\nAUX 1 → 100 В / COM\nстартовая сумма 16 Вт",fillcolor="#edf5ed"];
  coat [label="Ручка «Гардероб»\nVA-130 · 100 В / 30 Вт"];
  wc [label="Ручка «Санузел»\nVA-130 · 100 В / 30 Вт"];
  osr [label="Гардероб 01\n1 × OSR608TBL · 10 Вт",fillcolor="#edf5ed"];
  wpl [label="Кабинки 04 + 05\n2 × WPL6TW параллельно\n3 Вт + 3 Вт",fillcolor="#edf5ed"];
  ipad -> mixer [label="2×RCA · C"]; dj -> mixer [label="2×RCA · D",style=dashed];
  wall -> mixer [label="Cat5e · Remote A",style=dashed,constraint=false];
  mixer -> dsp [label="OUT A\nEuroblock → XLR"];
  dsp -> pa [label="4× XLR\nвыходы 1–4"]; pa -> hall [label="4 отдельные пары\nпо одному каналу"];
  dsp -> sub [label="OUT 5 · LINE\nXLR → RCA/LFE"];
  mixer -> match [label="OUT B\nEuroblock"]; match -> tr [label="RCA"]; tr -> coat [label="100 В",color="#4e755b"];
  tr -> wc [label="100 В",color="#4e755b"];
  coat -> osr [label="отдельная трасса",color="#4e755b"];
  wc -> wpl [label="отдельная трасса",color="#4e755b"];
  {rank=same; hall;sub;osr;wpl}
}
