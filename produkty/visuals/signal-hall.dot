cm [label="CM82\nRemote A · RJ45\nOUT A · Euroblock"];
dsp [label="DCX2496LE\nIN A → OUT 1–5\n1–4: HPF + лимитеры\n5: LPF, уровень\n6: свободен"];
volta [label="VOLTA LIVE 4.400\nIN 1–4 · XLR\nOUT 1–4 · speakON\nНезависимые каналы"];
z1 [label="З1 · KEF Q350\nСо стороны кассы"];
