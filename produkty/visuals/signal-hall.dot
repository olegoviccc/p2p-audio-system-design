sub [label="KEF Kube 8 MIE\nЛинейный вход RCA/LFE\nСетевой вход 230 В",fillcolor="#e9f1ee"];
power [label="Отдельная розетка\n230 В у сабвуфера",fillcolor="#f6f2ec"];
