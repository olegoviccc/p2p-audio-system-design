digraph Hall {
graph [rankdir=LR,bgcolor="white",pad=.28,nodesep=.23,ranksep=.50,splines=polyline,labelloc=t,labeljust=l,fontname="DejaVu Sans Bold",fontsize=20,label="02  /  ЗАЛ И САБВУФЕР\nПонятия OUT A, IN A и номера выходов относятся к конкретным аппаратам"];
